{
  "name": "@dff652/dsh-agent-mail-ui",
  "version": "0.1.2",
  "description": "DeepSeek Harness client/host UI for an already mounted Agent Mail MCP namespace",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "agent-mail",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dff652/deepseek-harness-community-plugins.git",
    "directory": "packages/dsh-agent-mail-ui"
  },
  "homepage": "https://github.com/dff652/deepseek-harness-community-plugins/tree/main/packages/dsh-agent-mail-ui#readme",
  "bugs": {
    "url": "https://github.com/dff652/deepseek-harness-community-plugins/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./view": "./view.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "index.js",
    "client.js",
    "view.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  }
}
