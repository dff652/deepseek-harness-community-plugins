{
  "name": "deepseek-harness-community-plugins",
  "version": "0.1.1",
  "private": true,
  "description": "Reviewed configuration-only DeepSeek Harness bundles for AI Asset Hub, Agent Mail and AgentMemory",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dff652/deepseek-harness-community-plugins.git"
  },
  "homepage": "https://github.com/dff652/deepseek-harness-community-plugins#readme",
  "bugs": {
    "url": "https://github.com/dff652/deepseek-harness-community-plugins/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:repo": "node scripts/check-public-repo.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:activation:aiah": "node tests/dsh-ai-asset-hub-activation.acceptance.mjs",
    "test:lifecycle:aiah": "node tests/dsh-ai-asset-hub-lifecycle.acceptance.mjs",
    "test:activation:agent-mail": "node tests/dsh-agent-mail-activation.acceptance.mjs",
    "test:lifecycle:agent-mail": "node tests/dsh-agent-mail-lifecycle.acceptance.mjs",
    "test:activation:agentmemory": "node tests/dsh-agentmemory-activation.acceptance.mjs",
    "test:lifecycle:agentmemory": "node tests/dsh-agentmemory-lifecycle.acceptance.mjs",
    "test:clean-profile:agentmemory": "node tests/dsh-agentmemory-clean-profile.acceptance.mjs",
    "test:coexistence": "node tests/dsh-agent-mail-coexistence.acceptance.mjs",
    "verify:aiah": "node scripts/verify-aiah-mcp.mjs",
    "verify:agent-mail": "node scripts/verify-agent-mail-mcp.mjs",
    "verify:agentmemory": "node scripts/verify-agentmemory-mcp.mjs",
    "verify:marketplace:aiah": "node scripts/verify-aiah-marketplace.mjs",
    "verify:marketplace:aiah:backend": "node scripts/verify-aiah-market-backend.mjs",
    "test:real-mcp:agentmemory": "node tests/dsh-agentmemory-real-mcp.acceptance.mjs",
    "pack:aiah": "npm pack --workspace @dff652/dsh-ai-asset-hub --ignore-scripts",
    "pack:agent-mail": "npm pack --workspace @dff652/dsh-agent-mail --ignore-scripts",
    "pack:agentmemory": "npm pack --workspace @dff652/dsh-agentmemory --ignore-scripts"
  }
}
